{
  "name": "dunezone",
  "private": true,
  "workspaces": {
    "packages": [
      "tools/svg-authoring"
    ],
    "catalog": {
      "@vitest/browser-playwright": "5.0.5",
      "@vitest/coverage-v8": "5.0.5",
      "oxfmt": "0.73.0",
      "oxlint": "1.88.0",
      "oxlint-tsgolint": "7.0.2004",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
      "vite-plus": "1.3.0",
      "vitest": "5.0.5"
    }
  },
  "type": "module",
  "scripts": {
    "app:build": "vp build .",
    "app:dev": "bash ./scripts/app-dev.sh",
    "app:preview": "vp preview",
    "build-storybook": "storybook build --stats-json",
    "check": "bun run check:play-colors && bun run verify:palette && bun run lint && bun run format:check && bun run check:react-compiler && bun run publisher:manifest:verify-changed",
    "check:app-layout": "node scripts/assert-app-layout.ts",
    "check:breakpoints": "node scripts/assert-breakpoints.ts",
    "check:convex-skip": "node scripts/assert-no-convex-skip-in-domain-db.ts",
    "check:css-orphans": "node scripts/assert-no-orphan-css-classes.ts",
    "check:css-vars": "node scripts/assert-css-custom-properties-defined.ts",
    "check:e2e-shards": "node scripts/assert-e2e-shards-cover.ts",
    "check:play-colors": "node scripts/assert-play-colors.ts",
    "check:prose": "node scripts/assert-no-ai-tells.ts",
    "check:react-compiler": "bun run scripts/assert-react-compiler.ts",
    "chromatic": "chromatic",
    "cloudflare:drift-check": "bun run ./scripts/cloudflare-live-drift.ts",
    "convex:deploy": "convex deploy",
    "convex:dev": "bun run migrations:dev-strict && convex dev",
    "dependencies:audit": "bun run ./scripts/dependency-audit.ts",
    "e2e:local": "bash ./scripts/e2e-local.sh",
    "e2e:seed": "npx convex run e2e:seedBaseline '{\"ownerEmail\":\"e2e-user-a@example.com\"}'",
    "e2e:test": "bash ./scripts/e2e-playwright.sh",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "game:dry-run": "wrangler deploy --dry-run --config workers/game/wrangler.jsonc",
    "game:startup": "wrangler check startup --cwd workers/game --config wrangler.jsonc --outfile /tmp/dunezone-game-startup.cpuprofile",
    "game:test": "vp test run workers/game",
    "game:typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit -p workers/game/tsconfig.json",
    "game:types": "wrangler types workers/game/worker-configuration.d.ts --env-interface GameEnv --config workers/game/wrangler.jsonc",
    "game:types:check": "wrangler types workers/game/worker-configuration.d.ts --env-interface GameEnv --check --config workers/game/wrangler.jsonc",
    "generate": "bun run generate:palette && bun run ./scripts/generate.ts",
    "generate:images": "bun run ./scripts/generate-images.ts",
    "generate:objs": "bun run ./scripts/generate-objs.ts",
    "generate:palette": "bun run scripts/generate-palette.ts",
    "generate:rulebook-board": "node scripts/generate-rulebook-board.ts",
    "generate:vectors": "bun run ./scripts/generate-vectors.ts",
    "knip": "knip",
    "lint": "vp lint . --deny-warnings",
    "lint:ci": "vp lint . --deny-warnings --format=github",
    "lint:fix": "vp lint . --fix",
    "media:backfill": "bun run ./scripts/media-backfill.ts",
    "media:gate": "bun run ./scripts/media-gate.ts",
    "media:gc": "bun run ./scripts/media-gc.ts",
    "media:lock": "bun run ./scripts/media-lock.ts",
    "media:publish": "bun run ./scripts/media-publish.ts",
    "media:sync": "bun run ./scripts/media-sync.ts",
    "migrations:deploy": "bun run ./scripts/migration-guards.ts deploy 2700000 5000 --prod",
    "migrations:dev-strict": "bun run ./scripts/migration-guards.ts dev-strict 300000 2000",
    "migrations:narrow-check": "bun run ./scripts/migration-guards.ts narrow-check --prod",
    "migrations:run-local-required": "bun run migrations:dev-strict",
    "migrations:static-check": "bun run ./scripts/migration-guards.ts static-check",
    "play:local": "bun run scripts/play-local.ts",
    "play:record": "RECORD_JOURNEY=1 vp test run workers/game/journey.record.native.test.ts && vp fmt src/app/routes/_app/play/journey.recording/journey.json",
    "play:watch": "bun --no-env-file scripts/play-watch.ts",
    "provision": "bun run ./scripts/provision.ts",
    "publisher:application-runtime:verify": "node --experimental-strip-types ./scripts/verify-application-runtime.ts",
    "publisher:assets": "bun run app:build && vp build --config workers/publisher/vite.config.ts && vp build --config workers/publisher/rulebook-html-renderer.vite.config.ts && bun run publisher:rulebook-html-runtime:verify && bun run ./scripts/assemble-publisher-assets.ts",
    "publisher:assets:check": "bun run ./scripts/assemble-publisher-assets.ts --check-only",
    "publisher:capture-contract-regression": "bun run publisher:assets && bun run workers/publisher/capture-contract-regression.ts",
    "publisher:dry-run": "bun run publisher:assets && wrangler deploy --dry-run --config workers/publisher/wrangler.jsonc",
    "publisher:font-regression": "bun run publisher:assets && bun run workers/publisher/font-regression.ts",
    "publisher:manifest:verify-changed": "bun run ./scripts/verify-changed-publisher-manifest.ts",
    "publisher:omit-static-rasters": "bun run ./scripts/assemble-publisher-assets.ts --omit-static-rasters",
    "publisher:release:dry-run": "wrangler deploy --dry-run --config workers/publisher/wrangler.jsonc",
    "publisher:release:verify": "bun run publisher:types:check && bun run publisher:dry-run && git diff --exit-code -- workers/publisher/renderer-manifest.generated.ts",
    "publisher:retain-assets": "bun run ./scripts/retain-application-assets.ts",
    "publisher:rulebook-html-runtime:verify": "bun run ./scripts/verify-rulebook-html-runtime.ts",
    "publisher:secret:publish-token": "wrangler secret put MEDIA_PUBLISH_TOKEN --config workers/publisher/wrangler.jsonc",
    "publisher:startup": "wrangler check startup --cwd workers/publisher --config wrangler.jsonc --outfile /tmp/asset-publisher-startup.cpuprofile",
    "publisher:test": "vp test run workers/publisher",
    "publisher:typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit -p workers/publisher/tsconfig.json",
    "publisher:types": "wrangler types workers/publisher/worker-configuration.d.ts --config workers/publisher/wrangler.jsonc",
    "publisher:types:check": "wrangler types workers/publisher/worker-configuration.d.ts --check --config workers/publisher/wrangler.jsonc",
    "statistics:verify": "bun run ./scripts/verify-statistics.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:test": "vp test run --config vitest.storybook.config.ts",
    "storybook:test:shard": "bun run ./scripts/storybook-shard.ts",
    "test": "vp test run --exclude 'workers/game/**' --exclude 'workers/publisher/**'",
    "test:browser-launch": "vp test run --config vitest.browser-launch.config.ts",
    "test:local-convex-isolation": "bun run ./scripts/test-local-convex-isolation.ts",
    "test:mutation": "stryker run",
    "tool:dev": "bun run --cwd tools/svg-authoring dev",
    "tool:test": "bun run --cwd tools/svg-authoring test",
    "tool:test:e2e": "bun run --cwd tools/svg-authoring test:e2e",
    "tool:typecheck": "bun run --cwd tools/svg-authoring typecheck",
    "tutorial:mirror": "bun run ./scripts/tutorial-mirror.ts",
    "tutorial:pull": "bun run ./scripts/tutorial-pull.ts && vp fmt src/app/routes/_app/tutorial/setup/catalogue.json",
    "tutorial:record": "RECORD_TUTORIAL=1 vp test run workers/game/tutorial.record.native.test.ts && vp fmt src/app/routes/_app/tutorial/setup/setup.json",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit && node ./node_modules/@typescript/native/bin/tsc --noEmit -p workers/storybook/tsconfig.service-worker.json",
    "verify:images": "bun run ./scripts/verify-images.ts",
    "verify:palette": "bun run scripts/generate-palette.ts --check",
    "verify:storybook-publication": "bun run ./scripts/verify-storybook-publication.ts",
    "verify:vectors": "bun run ./scripts/verify-vectors.ts",
    "worktree:setup": "bash ./scripts/codex-worktree-setup.sh",
    "worktree:setup:paperclip": "bash ./scripts/paperclip-worktree-setup.sh"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/aggregate": "0.3.1",
    "@convex-dev/auth": "0.0.96",
    "@convex-dev/migrations": "^0.3.6",
