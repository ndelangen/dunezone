{
  "name": "dunezone",
  "private": true,
  "workspaces": [
    "tools/svg-authoring"
  ],
  "type": "module",
  "scripts": {
    "app:build": "vite build",
    "app:dev": "bash ./scripts/app-dev.sh",
    "app:preview": "vite preview",
    "build-storybook": "storybook build",
    "check": "bun run lint && bun run format:check",
    "check:convex-skip": "node scripts/assert-no-convex-skip-in-domain-db.mjs",
    "cloudflare:drift-check": "bun run ./scripts/cloudflare-live-drift.ts",
    "convex:deploy": "convex deploy",
    "convex:dev": "bun run migrations:dev-strict && convex dev",
    "e2e:local": "bash ./scripts/e2e-local.sh",
    "e2e:seed": "npx convex run e2e:seedBaseline '{\"ownerEmail\":\"e2e-user-a@example.com\"}'",
    "e2e:test": "bash ./scripts/e2e-playwright.sh",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "generate": "bun run ./scripts/generate.ts",
    "generate:images": "bun run ./scripts/generate-images.ts",
    "generate:objs": "bun run ./scripts/generate-objs.ts",
    "generate:vectors": "bun run ./scripts/generate-vectors.ts",
    "knip": "knip",
    "lint": "oxlint . --deny-warnings",
    "lint:ci": "oxlint . --deny-warnings --format=github",
    "lint:fix": "oxlint . --fix",
    "migrations:deploy": "bun run ./scripts/migration-guards.ts deploy 2700000 5000 --prod",
    "migrations:dev-strict": "bun run ./scripts/migration-guards.ts dev-strict 300000 2000",
    "migrations:narrow-check": "bun run ./scripts/migration-guards.ts narrow-check --prod",
    "migrations:run-local-required": "bun run migrations:dev-strict",
    "migrations:static-check": "bun run ./scripts/migration-guards.ts static-check",
    "provision": "bun run ./scripts/provision.ts",
    "publisher:assets": "bun run app:build && bun run build-storybook && vite build --config workers/publisher/vite.config.ts && bun run ./scripts/assemble-publisher-assets.ts",
    "publisher:assets:check": "bun run ./scripts/assemble-publisher-assets.ts --check-only",
    "publisher:capture-contract-regression": "bun run publisher:assets && bun run workers/publisher/capture-contract-regression.ts",
    "publisher:dry-run": "bun run publisher:assets && wrangler deploy --dry-run --config workers/publisher/wrangler.jsonc",
    "publisher:font-regression": "bun run publisher:assets && bun run workers/publisher/font-regression.ts",
    "publisher:release:dry-run": "wrangler deploy --dry-run --config workers/publisher/wrangler.jsonc",
    "publisher:release:verify": "bun run publisher:dry-run && git diff --exit-code -- workers/publisher/renderer-manifest.generated.ts",
    "publisher:startup": "wrangler check startup --cwd workers/publisher --config wrangler.jsonc --outfile /tmp/asset-publisher-startup.cpuprofile",
    "publisher:test": "vitest run workers/publisher",
    "publisher:typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit -p workers/publisher/tsconfig.json",
    "publisher:types": "wrangler types workers/publisher/worker-configuration.d.ts --config workers/publisher/wrangler.jsonc",
    "publisher:types:check": "wrangler types workers/publisher/worker-configuration.d.ts --check --config workers/publisher/wrangler.jsonc",
    "statistics:verify": "bun run ./scripts/verify-statistics.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:test": "vitest run --config vitest.storybook.config.ts",
    "test": "vitest run --passWithNoTests",
    "tool:dev": "bun run --cwd tools/svg-authoring dev",
    "tool:test": "bun run --cwd tools/svg-authoring test",
    "tool:test:e2e": "bun run --cwd tools/svg-authoring test:e2e",
    "tool:typecheck": "bun run --cwd tools/svg-authoring typecheck",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "verify:images": "bun run ./scripts/verify-images.ts",
    "verify:vectors": "bun run ./scripts/verify-vectors.ts",
    "worktree:setup": "bash ./scripts/codex-worktree-setup.sh"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/aggregate": "^0.2.2",
    "@convex-dev/auth": "^0.0.94",
    "@convex-dev/migrations": "^0.3.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/caladea": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@mantine/core": "9.5.1",
    "@mantine/hooks": "9.5.1",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-start": "^1.168.35",
    "clsx": "^2.1.1",
    "convex": "^1.43.0",
    "convex-helpers": "^0.1.121",
    "crypto-js": "^4.2.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.28.0",
    "markdown-to-jsx": "^9.10.2",
    "pdf-lib": "1.17.1",
    "react": "^19.2.8",
    "react-children-utilities": "^2.10.0",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/playwright": "1.3.3",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@codecov/bundle-analyzer": "^2.0.1",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/addon-vitest": "10.5.6",
    "@storybook/tanstack-react": "10.5.6",
    "@tanstack/devtools-vite": "^0.8.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "0.185.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "convex-test": "^0.0.55",
    "jsdom": "^30.0.1",
    "knip": "^6.32.0",
    "linkedom": "0.18.12",
    "monocart-coverage-reports": "^2.12.12",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "playwright": "^1.62.1",
    "recursive-readdir-files": "^2.3.2",
    "sharp": "0.35.3",
    "storybook": "^10.5.6",
    "svgo": "4.0.2",
    "svgpath": "2.6.0",
    "three": "0.185.0",
    "typescript": "^6.0.3",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "immutable": "5.1.9",
    "js-yaml": "4.3.1",
    "launch-editor": "2.14.1",
    "picomatch": "4.0.5",
    "postcss": "8.5.25",
    "seroval": "1.5.6",
    "shell-quote": "1.10.0",
    "ws": "8.21.2"
  },
  "packageManager": "bun@1.3.14"
}
