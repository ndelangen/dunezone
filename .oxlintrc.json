{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "vitest", "import", "jsdoc"],
  "jsPlugins": ["./scripts/oxlint-prefer-block-comments.mjs"],
  "categories": {
    "correctness": "error"
  },
  "overrides": [
    {
      "files": ["**/*.generated.ts", "**/*.gen.ts", "**/worker-configuration.d.ts"],
      "rules": {
        "local/prefer-block-comments": "off"
      }
    },
    {
      /**
       * A component renders what it is given; it does not go and get things.
       *
       * That is the whole rule, and it is narrower than "domain-free" on purpose. A component may
       * know the *shape* of what it renders — a `FactionCatalogueEntry` type says exactly that, and
       * types are erased anyway — and it may compose a game renderer or a pure helper. What it may
       * not do is reach for data itself, or decide where the reader goes next, because either one
       * makes it unusable in a story and unusable on a second page.
       */
      "files": ["src/app/ui/**"],
      "excludeFiles": [
        "src/app/ui/**/*.stories.tsx",
        "src/app/ui/**/*.stories.fixture.tsx",
        "src/app/ui/**/*.test.ts",
        "src/app/ui/**/*.test.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["convex", "convex/*", "**/convex/**", "../**/convex/**"],
                "message": "A component must not fetch. Convex belongs in a domain module (`src/app/db/<domain>.ts`); take the result as a prop."
              },
              {
                "group": [
                  "@db/**",
                  "@app/db",
                  "@app/db/**",
                  "**/src/app/db/**",
                  "../**/db/*",
                  "../**/db/core",
                  "../**/db/core/*"
                ],
                "allowTypeImports": true,
                "message": "A component must not fetch. Import the *type* if you need to say what shape you render (`import type { FactionEntry }`), and take the value as a prop."
              },
              {
                "group": ["@app/shell/**", "@app/widgets/**", "@app/routes/**"],
                "message": "The kit is imported by the shell, by widgets and by routes — never the other way around."
              }
            ],
            "paths": [
              {
                "name": "@tanstack/react-router",
                "importNames": [
                  "useNavigate",
                  "useLoaderData",
                  "useLoaderDeps",
                  "useParams",
                  "useSearch",
                  "useRouter",
                  "useRouterState",
                  "useMatch",
                  "useMatches",
                  "useChildMatches",
                  "useParentMatches",
                  "useLocation",
                  "useRouteContext",
                  "useBlocker",
                  "useCanGoBack",
                  "Navigate",
                  "redirect"
                ],
                "message": "A component may point at a place — `Link`, `createLink`, `renderRoot` — but it may not decide to go there, or read the route it happens to be on. Take a callback, or let the caller render the Link."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["convex/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/src/app/**",
                  "../src/app/**",
                  "../../src/app/**",
                  "@app/**",
                  "@ui/**",
                  "@db/**"
                ],
                "message": "The server must not import client code. A contract both sides need — a Zod schema, a tag vocabulary — belongs in `src/shared/`, which both may import. `@db/*` resolves to `src/app/db/<domain>.ts`, so it is client code too."
              },
              {
                "group": ["**/_generated/server"],
                "importNames": ["mutation", "internalMutation"],
                "message": "Use the trigger-aware builders from ./functions instead. Restated here because an override replaces the root rule for the files it matches rather than adding to it."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["workers/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/src/app/**",
                  "../src/app/**",
                  "../../src/app/**",
                  "@app/**",
                  "@ui/**",
                  "@db/**"
                ],
                "message": "The publisher Worker is a separate deploy artifact and must not import application code. Shared runtime contracts belong in `src/shared/`. `@db/*` resolves to `src/app/db/<domain>.ts`, so it is application code too."
              },
              {
                "group": ["**/_generated/server"],
                "importNames": ["mutation", "internalMutation"],
                "message": "Use the trigger-aware builders from ./functions instead. Restated here because an override replaces the root rule for the files it matches rather than adding to it."
              }
            ]
          }
        ]
      }
    }
  ],
  "rules": {
    "curly": ["error", "all"],
    "local/prefer-block-comments": "error",
    "eqeqeq": ["error", "smart"],
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    "jsdoc/check-tag-names": [
      "error",
      {
        "definedTags": ["vitest-environment"]
      }
    ],
    "jsx-a11y/prefer-tag-over-role": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/_generated/server"],
            "importNames": ["mutation", "internalMutation"],
            "message": "Use the trigger-aware builders from ./functions instead."
          }
        ]
      }
    ],
    "object-shorthand": "error",
    "react/jsx-curly-brace-presence": [
      "error",
      {
        "props": "never",
        "children": "never",
        "propElementValues": "always"
      }
    ],
    "react/self-closing-comp": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "separate-type-imports"
      }
    ],
    "unicorn/numeric-separators-style": "error",
    "vitest/no-conditional-expect": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/require-to-throw-message": "off",
    "vitest/valid-expect": "off"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "**/dist",
    "**/supabase/.temp",
    "**/routeTree.gen.ts",
    "**/*.gen.ts",
    "**/workers/publisher/worker-configuration.d.ts",
    "**/convex/_generated",
    "docs/research/**",
    "tools/**"
  ]
}
