{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.mutation.config.ts"
  },
  "mutate": ["src/shared/play/loadTarget.ts"],
  "concurrency": 2,
  "reporters": ["clear-text", "html", "json"],
  "htmlReporter": {
    "fileName": "test-results/code-health/mutation.html"
  },
  "jsonReporter": {
    "fileName": "test-results/code-health/mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 0
  },
  "ignorePatterns": [
    "media",
    "public",
    "docs",
    "convex",
    "workers",
    "tools",
    ".github",
    ".agents",
    ".claude",
    "tsconfig.json"
  ]
}
