  "sourceDescription": "Monochrome troop silhouettes rebuilt with the built-in image generation tool from seven user-supplied reference images. Source authorship and publication were not independently verified.",
  "approval": {
    "date": "2026-10-28",
    "scope": "Publish all twelve approved troop vectors. The stalker and shield team use their approved simplified second revisions.",
    "evidence": "get them to prod"
  },
  "preparation": {
    "bitmapStage": "Each subject was rebuilt as a high-resolution bitmap and approved in the local artwork review. Atreides and Harkonnen troop silhouettes set the detail level. Native generated outputs were enlarged for review to a 2048-pixel longest edge.",
    "mask": "Alpha multiplied by inverse luminance preserves white cutouts. Gaussian sigma 0.65 pixels, threshold 0.5, minimum component area 12 pixels.",
    "trace": "Potrace 1.16, turdsize 12, alphamax 1.0, opttolerance 0.4. Existing SVG authoring assigns the root ID and stamp, uniformly normalizes to a 100 by 100 viewBox and applies the troop optimization profile.",
    "paint": "Monochrome geometry inherits caller paint; structural gaps are transparent.",
    "collection": "The existing Troops category supplies catalogue and picker membership."
  },
