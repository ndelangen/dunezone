{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "Europe/Amsterdam",
  "schedule": ["before 7am on monday"],
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "minimumReleaseAge": "7 days",
  "automerge": false,
  "dependencyDashboard": true,
  "vulnerabilityAlerts": {
    "groupName": "Security fixes",
    "prConcurrentLimit": 1
  },
  "enabledManagers": ["bun", "npm", "bun-version", "github-actions", "dockerfile", "docker-compose"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["bun", "npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Development dependencies"
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": ["three", "@react-three/fiber", "@storybook/tanstack-react", "@convex-dev/auth"],
      "dependencyDashboardApproval": true
    }
  ]
}
