{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "Europe/Amsterdam",
  "schedule": ["before 7am on monday"],
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "minimumReleaseAge": "3 days",
  "automerge": false,
  "dependencyDashboard": true,
  "vulnerabilityAlerts": {
    "groupName": "Security fixes",
    "groupSlug": "security-fixes",
    "prConcurrentLimit": 1
  },
  "enabledManagers": ["bun", "npm", "bun-version", "github-actions", "dockerfile", "docker-compose"],
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Routine dependencies",
      "groupSlug": "routine-dependencies"
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Satori's OpenType reader needs the inflateSync output-buffer argument removed in fflate 0.8.",
      "matchPackageNames": ["fflate"],
      "matchDepTypes": ["overrides"],
      "allowedVersions": "<0.8.0"
    },
    {
      "description": "Semgrep's pinned binary dependencies have no Python 3.15 wheels.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["actions/python-versions"],
      "matchFileNames": [".github/workflows/code-health.yml"],
      "allowedVersions": "<3.15"
    },
    {
      "matchPackageNames": ["oxlint", "satori"],
      "groupName": null,
      "groupSlug": null,
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": ["three", "@react-three/fiber", "@storybook/tanstack-react", "@convex-dev/auth"],
      "groupName": null,
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": ["storybook", "@storybook/**", "vitest", "@vitest/**"],
      "groupName": "Storybook",
      "groupSlug": "storybook",
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": [
        "three",
        "@react-three/fiber",
        "@react-three/drei",
        "@types/three",
        "three-mesh-bvh",
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "Tabletop rendering",
      "groupSlug": "tabletop-rendering",
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": [
        "convex",
        "convex-test",
        "convex-helpers",
        "@convex-dev/aggregate",
        "@convex-dev/migrations",
        "@convex-dev/rate-limiter",
        "ghcr.io/get-convex/convex-backend",
        "ghcr.io/get-convex/convex-dashboard"
      ],
      "groupName": "Convex runtime",
      "groupSlug": "convex-runtime"
    }
  ]
}
