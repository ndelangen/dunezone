# Every file under /public/ carries a content hash in its name, so a new build never reuses a path.
# A browser that has one keeps it for a year without asking; without this the Workers assets default
# (max-age=0, must-revalidate) makes a warm navigation revalidate every chunk before the page can run.
/public/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts, vector icons, site art and the header video keep their names across builds, so they cannot be immutable.
# Without a rule they take the Workers assets default (max-age=0, must-revalidate), and every reload asks again for
# each font before text can draw. An hour fresh, then served from cache while it revalidates, keeps them warm; a
# replaced file reaches a returning visitor within the hour.
/font/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/vector/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/web/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/video/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

# Play is an unlisted beta (#1094). The play pages set a robots meta only once JavaScript runs, so the
# header also covers crawlers that never run it. Rules match the request path, so they reach the SPA
# document these routes are served from without making the Worker run first.
/play
  X-Robots-Tag: noindex

/play/*
  X-Robots-Tag: noindex

# Each release reads the previous manifest before retaining its browser bundles.
/application-assets.json
  Cache-Control: no-store

# Application documents cannot be embedded in another site.
/*
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; object-src 'none'
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
